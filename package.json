{
  "name": "@aivangogh/ph-address",
  "version": "2026.2.2",
  "description": "A collection of philippine geographic data based on PSGC",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "LICENCE", "README.md"],
  "author": {
    "name": "Ivan Gemota",
    "email": "aivangogh.dev@gmail.com",
    "url": "https://github.com/aivangogh"
  },
  "repository": {
    "url": "git+ssh://git@github.com/aivangogh/ph-address.git"
  },
  "homepage": "https://aivangogh.dev/tools/ph-address",
  "license": "MIT",
  "packageManager": "pnpm@10.15.1",
  "keywords": [
    "philippines",
    "address",
    "ph-address",
    "psgc",
    "philippine-address",
    "philippines-address",
    "psgc-data",
    "regions",
    "provinces",
    "cities",
    "municipalities",
    "barangays"
  ],
  "scripts": {
    "build:tsup": "tsup",
    "release": "pnpm build && changeset publish",
    "test": "vitest",
    "test:prepare": "pnpm build:csv-ts",
    "migrate:psgc": "tsx scripts/migrate-psgc.ts",
    "migrate:postal-codes": "tsx scripts/migrate-postal-codes.ts",
    "build:csv-ts": "tsx scripts/convert-to-csv.ts src/data-csv-ts/index.ts",
    "data:check": "pnpm migrate:psgc --file=assets/PSGC-2Q-2026-Publication-Datafile.xlsx && pnpm migrate:postal-codes && pnpm build:csv-ts && git diff --exit-code -- src/data src/data-csv src/data-csv-ts",
    "build": "pnpm build:csv-ts && pnpm build:tsup",
    "typecheck": "tsc --noEmit",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:published": "node scripts/test-published-rc.mjs",
    "format": "prettier --write .",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "@types/node": "^25.5.0",
    "@types/pako": "^2.0.4",
    "@vitest/coverage-v8": "^2.0.4",
    "playwright": "1.55.0",
    "prettier": "^3.3.2",
    "tsx": "^4.20.6",
    "tsup": "^8.1.2",
    "typescript": "^5.2.2",
    "vitest": "^2.0.4",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "pako": "^2.1.0"
  }
}
